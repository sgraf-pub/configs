[Unit]
Description=Mute audio on boot
After=pipewire.service wireplumber.service
ConditionUser=!@system

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for i in 1 2 3 4 5; do /usr/bin/wpctl set-mute @DEFAULT_AUDIO_SINK@ 1 2>/dev/null && exit 0; sleep 1; done; /usr/bin/wpctl set-mute @DEFAULT_AUDIO_SINK@ 1'
RemainAfterExit=yes

[Install]
WantedBy=default.target
